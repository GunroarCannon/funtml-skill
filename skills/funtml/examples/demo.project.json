  "sections": [
    {
      "type": "cards",
      "title": "What you get",
      "lede": "Everything a project page needs, already styled. You only bring the words and numbers.",
      "items": [
        {
          "title": "Bouncy diagrams",
          "text": "Boxes spring back when dragged and tug their neighbours. Arrows march and little dots flow along them.",
          "icon": "network",
          "tag": "signature"
        },
        {
          "title": "Charts that overshoot",
          "text": "Bars, lines and donuts grow past their value and settle. Hover for a sticker tooltip.",
          "icon": "chart"
        },
        {
          "title": "Four looks",
          "text": "Graffiti wall, school notebook, ink and paper, blueprint. One word in the JSON, or the paint button.",
          "icon": "paint"
        },
        {
          "title": "Weak-model proof",
          "text": "A build script fixes the usual mistakes and warns about the rest, so small models still ship a good page.",
          "icon": "shield"
        },
        {
          "title": "Real facts only",
          "text": "A scanner reads your repo and fills in file counts, languages and who-imports-who. Nothing is invented.",
          "icon": "search"
        },
        {
          "title": "One file out",
          "text": "The result is a single index.html. Host it anywhere, email it, open it offline.",
          "icon": "box"
        }
      ]
    },
    {
      "type": "steps",
      "title": "Make one in 5 steps",
      "lede": "This is the whole loop an AI follows.",
      "items": [
        {
          "title": "Scan",
          "text": "Run `scan_project.py` on the repo to get true numbers and a starter file."
        },
        {
          "title": "Read",
          "text": "Skim the README and the main files so the words are right."
        },
        {
          "title": "Write",
          "text": "Fill `project.json`: tagline, cards, steps, notes on each box."
        },
        {
          "title": "Build",
          "text": "Run `build_site.py`. Fix every ERROR and WARN it prints."
        },
        {
          "title": "Look",
          "text": "Take a screenshot with `shot.py` and check it with your own eyes."
        }
      ]
    },
    {
      "type": "pipeline",
      "title": "How it works",
      "lede": "Data flows left to right. Inputs and outputs are shown on each stage.",
      "steps": [
        {
          "label": "Your repo",
          "note": "Any language.",
          "icon": "folder",
          "out": [
            "files"
          ]
        },
        {
          "label": "Scanner",
          "note": "Counts lines, finds imports, reads git.",
          "icon": "search",
          "in": [
            "files"
          ],
          "out": [
            "facts"
          ]
        },
        {
          "label": "project.json",
          "note": "Facts plus your words.",
          "icon": "file",
          "in": [
            "facts"
          ],
          "out": [
            "story"
          ]
        },
        {
          "label": "Builder",
          "note": "Checks, fixes, inlines everything.",
          "icon": "gear",
          "in": [
            "story"
          ],
          "out": [
            "index.html"
          ]
        },
        {
          "label": "The page",
          "note": "Springs, charts, confetti.",
          "icon": "rocket",
          "in": [
            "index.html"
          ]
        }
      ]
    },
    {
      "type": "graph",
      "title": "What goes into what",
      "lede": "Drag a box and let go. Click one to see what feeds it and where it goes. Click a colour chip to focus a group.",
      "groups": {
        "you": {
          "name": "You write"
        },
        "tools": {
          "name": "Scripts"
        },
        "src": {
          "name": "Page source"
        },
        "out": {
          "name": "Output"
        }
