      "nodes": [
        {
          "id": "repo",
          "label": "your project",
          "group": "you",
          "icon": "folder",
          "note": "The thing you want a page about. Any language, any size."
        },
        {
          "id": "scan",
          "label": "scan_project.py",
          "group": "tools",
          "icon": "search",
          "note": "Counts lines per language and folder, reads imports to find which part uses which, reads README and git history."
        },
        {
          "id": "json",
          "label": "project.json",
          "group": "you",
          "icon": "file",
          "note": "The only file you edit. Meta, hero and a list of sections. Each section is one block type."
        },
        {
          "id": "build",
          "label": "build_site.py",
          "group": "tools",
          "icon": "gear",
          "note": "Validates the JSON, repairs small mistakes, removes emoji, and glues the page together."
        },
        {
          "id": "shell",
          "label": "shell.html",
          "group": "src",
          "note": "The empty page: fonts, the data tag, the script tag."
        },
        {
          "id": "css",
          "label": "style.css",
          "group": "src",
          "note": "Four themes as CSS variables, sticker cards, hard shadows, springy easing."
        },
        {
          "id": "engine",
          "label": "engine.js",
          "group": "src",
          "icon": "code",
          "note": "Draws every block, runs the spring physics for the graph, counts numbers up, throws confetti."
        },
        {
          "id": "out",
          "label": "index.html",
          "group": "out",
          "icon": "box",
          "note": "One self-contained file. Nothing else to host."
        },
        {
          "id": "you",
          "label": "a reader",
          "group": "out",
          "icon": "smile",
          "note": "Drags the boxes, clicks the mascot, changes the look."
        }
