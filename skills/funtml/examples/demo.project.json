{
  "meta": {
    "name": "funtml",
    "tagline": "Turn any project into a bouncy, sticker-style web page with diagrams and charts.",
    "theme": "wall",
    "ticker": [
      "one html file",
      "drag the boxes",
      "springs everywhere",
      "four looks",
      "no build tools",
      "works offline"
    ],
    "links": [
      {
        "label": "Source on GitHub",
        "url": "https://github.com/GunroarCannon/funtml-skill"
      }
    ],
    "footer": "Click things. Everything here is clickable on purpose."
  },
  "hero": {
    "subtitle": "You write one small JSON file about your project. funtml draws the page: hero, diagrams that bounce, charts that overshoot, sticker cards.",
    "stickers": [
      "JSON in",
      "HTML out",
      "no libraries",
      "phone friendly"
    ],
    "cta": [
      {
        "label": "How it works",
        "url": "#how-it-works"
      },
      {
        "label": "See the diagram",
        "url": "#what-goes-into-what"
      }
    ],
    "mascot": {
      "shape": "blob",
      "say": [
        "Hi, I am the mascot.",
        "Poke the boxes further down.",
        "Try the paint button in the menu."
      ]
