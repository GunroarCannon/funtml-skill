    {
      "type": "code",
      "title": "Try it",
      "filename": "terminal",
      "code": "python scripts/scan_project.py ./my-project --draft project.json\n# edit project.json: fill in the placeholders\npython scripts/build_site.py project.json index.html\npython scripts/shot.py index.html look.png"
    },
    {
      "type": "faq",
      "title": "Questions",
      "items": [
        {
          "q": "Does it need internet?",
          "a": "Only for the Google fonts. Without them it falls back to a system rounded font and still looks fine."
        },
        {
          "q": "Can I use my own colours?",
          "a": "Set `meta.accent` to any hex colour, and pick one of four themes."
        },
        {
          "q": "Why no emoji?",
          "a": "They look different on every device. The built-in SVG icons are crisp and match the theme."
        }
      ]
